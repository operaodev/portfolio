---
import Base from "../../layouts/Base.astro";
import { getArchivePosts } from "../../lib/archive_data";
import { getProjectPosts } from "../../lib/project_data";
import { getAllTags } from "../../lib/tags";
import { info } from "../../lib/info";

const [archivePosts, projectPosts] = await Promise.all([
    getArchivePosts(),
    getProjectPosts(),
]);
const posts = [...archivePosts, ...projectPosts];
const tags = getAllTags(posts);
---

<Base
    title={`Tags - ${info.site.name}`}
    description="Temas y etiquetas de los artículos y proyectos."
>
    <section class="page-container">
        <div class="max-w-3xl mx-auto">
            <header class="mb-8">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Etiquetas
                </h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    {tags.length} {tags.length === 1 ? "tema" : "temas"} en
                    todos los artículos y proyectos.
                </p>
            </header>
            <ul class="divide-y divide-border/40 border-t border-border/40">
                {tags.map((tag) => (
                    <li>
                        <a
                            href={`/tags/${tag.slug}`}
                            class="group flex items-baseline justify-between gap-4 py-3.5 transition-colors"
                        >
                            <span class="font-mono text-sm text-foreground transition-colors group-hover:text-accent">
                                <span class="text-accent/70">#</span>
                                {tag.name}
                            </span>
                            <span class="shrink-0 text-xs text-muted-foreground">
                                {tag.count} {tag.count === 1 ? "post" : "posts"}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Base>
