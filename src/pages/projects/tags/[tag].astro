---
import Base from "../../../layouts/Base.astro";
import { ProjectItem } from "../../../components/projects/ProjectList";
import { getProjectPosts, type Project } from "../../../lib/project_data";
import { getAllTags, slugifyTag } from "../../../lib/tags";
import { ChevronRight } from "@lucide/astro";

export async function getStaticPaths() {
    const projects = await getProjectPosts();
    const tags = getAllTags(projects);

    return tags.map((tagInfo) => {
        const matchingProjects = projects.filter((project) =>
            project.tags?.some((t) => slugifyTag(t) === tagInfo.slug),
        );
        return {
            params: { tag: tagInfo.slug },
            props: {
                tag: tagInfo.name,
                projects: matchingProjects,
            },
        };
    });
}

interface Props {
    tag: string;
    projects: Project[];
}

const { tag, projects } = Astro.props;
---

<Base
    title={`#${tag} - Etiquetas`}
    description={`Proyectos etiquetados con ${tag}.`}
>
    <section class="page-container">
        <div class="max-w-3xl mx-auto">
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
                    <li class="flex items-center gap-1.5">
                        <a
                            href="/"
                            class="transition-colors hover:text-foreground"
                        >
                            Inicio
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <a
                            href="/projects"
                            class="transition-colors hover:text-foreground"
                        >
                            Proyectos
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <a
                            href="/projects/tags"
                            class="transition-colors hover:text-foreground"
                        >
                            Etiquetas
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <span
                            aria-current="page"
                            class="font-medium text-foreground"
                        >
                            {tag}
                        </span>
                    </li>
                </ol>
            </nav>

            <header class="mb-10">
                <h1 class="break-words text-3xl font-bold tracking-tight sm:text-4xl">
                    <span class="text-accent">#</span>
                    {tag}
                </h1>
                <p class="mt-3 text-base text-muted-foreground">
                    {projects.length}{" "}
                    {projects.length === 1
                        ? "proyecto etiquetado"
                        : "proyectos etiquetados"}{" "}
                    con “{tag}”.
                </p>
            </header>

            <div class="mt-8 space-y-10 sm:space-y-12">
                {projects.map((project) => (
                    <ProjectItem project={project} />
                ))}
            </div>
        </div>
    </section>
</Base>
