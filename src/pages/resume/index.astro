---
import Base from "../../layouts/Base.astro";
import {
    Server,
    Download,
    User,
    Shield,
    Briefcase,
    GraduationCap,
} from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { resume, contacts } from "../../lib/info";
import { ProjectItem } from "../../components/projects/ProjectList";
import { getProjectPosts } from "../../lib/project_data";

const projects = await getProjectPosts();
const featuredProjects = projects.slice(0, 3);

const sectionTitleClass =
    "text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2";
---

<Base
    title={`${resume.name} - Resume`}
    description={`${resume.role} resume for ${resume.name}.`}
>
    <section class="page-container grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full space-y-10">
            <header class="space-y-6">
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-balance">
                        {resume.name}
                    </h1>
                    <p class="mt-2 text-lg md:text-xl text-muted-foreground/80">
                        {resume.role}
                    </p>
                </div>

                <div class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-4">
                    <div class="flex flex-wrap items-center gap-5">
                        {contacts.map((contact) => (
                            <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                aria-label={contact.label}
                                title={contact.label}
                                class="text-muted-foreground hover:text-accent transition-colors"
                            >
                                <Icon name={contact.label} class="w-8 h-8" />
                            </a>
                        ))}
                    </div>

                    {resume.downloads?.cv && (
                        <a
                            href={resume.downloads.cv.href}
                            download={resume.downloads.cv.filename ?? "cv.pdf"}
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-sm font-semibold rounded-md border border-border bg-foreground text-background hover:bg-foreground/90 transition-colors shadow-sm"
                        >
                            <Download size={14} /> Descargar CV
                        </a>
                    )}
                </div>
            </header>

            <section>
                <h2 class={sectionTitleClass}>
                    <User size={14} />
                    <span>Mi Perfil</span>
                </h2>
                <p class="text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                    {resume.bio}
                </p>
            </section>

            {featuredProjects.length > 0 && (
                <section>
                    <h2 class={sectionTitleClass}>
                        <Server size={14} />
                        <span>Proyectos destacados</span>
                    </h2>
                    <div class="space-y-6">
                        {featuredProjects.map((project) => (
                            <ProjectItem project={project} />
                        ))}
                    </div>
                </section>
            )}

            {resume.experience && resume.experience.length > 0 && (
                <section>
                    <h2 class={sectionTitleClass}>
                        <Briefcase size={14} />
                        <span>Experiencia</span>
                    </h2>
                    <div class="space-y-6">
                        {resume.experience.map((exp) => (
                            <div class="border-l-2 border-border pl-4 space-y-1.5">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-base font-semibold text-foreground">
                                        {exp.role}{" "}
                                        {exp.company && (
                                            <span class="text-muted-foreground font-normal">
                                                @ {exp.company}
                                            </span>
                                        )}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">
                                        {exp.period}
                                    </span>
                                </div>
                                <ul class="list-disc list-inside space-y-1 text-sm text-foreground/80">
                                    {exp.description.map((desc) => (
                                        <li class="text-pretty">{desc}</li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </section>
            )}

            {resume.skills && resume.skills.length > 0 && (
                <section>
                    <h2 class={sectionTitleClass}>
                        <Shield size={14} />
                        <span>Habilidades técnicas</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {resume.skills.map((cat) => (
                            <div class="p-3.5 border border-border rounded-md bg-card/20">
                                <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
                                    {cat.category}
                                </h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {cat.items.map((skill) => (
                                        <span class="text-sm px-2 py-0.5 rounded border border-border bg-card font-mono text-muted-foreground">
                                            {skill}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>
            )}

            {resume.education && resume.education.length > 0 && (
                <section>
                    <h2 class={sectionTitleClass}>
                        <GraduationCap size={14} />
                        <span>Educación y Certificados</span>
                    </h2>
                    <div class="space-y-4">
                        {resume.education.map((edu) => (
                            <div class="border-l-2 border-border pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">
                                        {edu.degree}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">
                                        {edu.period}
                                    </span>
                                </div>
                                <p class="text-xs text-muted-foreground">
                                    {edu.institution}
                                </p>
                            </div>
                        ))}
                    </div>
                </section>
            )}
        </div>
    </section>
</Base>
