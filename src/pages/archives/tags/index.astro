---
import Base from "../../../layouts/Base.astro";
import { getArchivePosts } from "../../../lib/archive_data";
import { getAllTags } from "../../../lib/tags";
import { info } from "../../../lib/info";
import { ChevronRight } from "@lucide/astro";

const posts = await getArchivePosts();
const tags = getAllTags(posts);
---

<Base
    title={`Etiquetas - ${info.site.name}`}
    description="Temas y etiquetas de los artículos."
>
    <section class="page-container">
        <div class="max-w-3xl mx-auto">
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
                    <li class="flex items-center gap-1.5">
                        <a href="/" class="transition-colors hover:text-foreground">
                            Inicio
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight size={12} class="opacity-60" aria-hidden="true" />
                        <a href="/archives" class="transition-colors hover:text-foreground">
                            Archives
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight size={12} class="opacity-60" aria-hidden="true" />
                        <span aria-current="page" class="font-medium text-foreground">
                            Etiquetas
                        </span>
                    </li>
                </ol>
            </nav>

            <header class="mb-8">
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Etiquetas
                </h1>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    {tags.length} {tags.length === 1 ? "tema" : "temas"} en
                    todos los artículos.
                </p>
            </header>
            <ul class="divide-y divide-border/40 border-t border-border/40">
                {tags.map((tag) => (
                    <li>
                        <a
                            href={`/archives/tags/${tag.slug}`}
                            class="group flex items-baseline justify-between gap-4 py-3.5 transition-colors"
                        >
                            <span class="min-w-0 break-words font-mono text-sm text-foreground transition-colors group-hover:text-accent">
                                <span class="text-accent/70">#</span>
                                {tag.name}
                            </span>
                            <span class="shrink-0 text-xs text-muted-foreground">
                                {tag.count} {tag.count === 1 ? "artículo" : "artículos"}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Base>
