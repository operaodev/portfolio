---
import Base from "../../../layouts/Base.astro";
import { PostItem } from "../../../components/archives/ArchiveList";
import { getArchivePosts } from "../../../lib/archive_data";
import { getAllTags, slugifyTag } from "../../../lib/tags";
import { ChevronRight } from "@lucide/astro";
import type { Post } from "../../../lib/search";

export async function getStaticPaths() {
    const posts = await getArchivePosts();
    const tags = getAllTags(posts);

    return tags.map((tagInfo) => {
        const matchingPosts = posts.filter((post) =>
            post.tags?.some((t) => slugifyTag(t) === tagInfo.slug),
        );
        return {
            params: { tag: tagInfo.slug },
            props: {
                tag: tagInfo.name,
                posts: matchingPosts,
            },
        };
    });
}

interface Props {
    tag: string;
    posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base
    title={`#${tag} - Etiquetas`}
    description={`Artículos etiquetados con ${tag}.`}
>
    <section class="page-container">
        <div class="max-w-3xl mx-auto">
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
                    <li class="flex items-center gap-1.5">
                        <a
                            href="/"
                            class="transition-colors hover:text-foreground"
                        >
                            Inicio
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <a
                            href="/archives"
                            class="transition-colors hover:text-foreground"
                        >
                            Archives
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <a
                            href="/archives/tags"
                            class="transition-colors hover:text-foreground"
                        >
                            Etiquetas
                        </a>
                    </li>
                    <li class="flex items-center gap-1.5">
                        <ChevronRight
                            size={12}
                            class="opacity-60"
                            aria-hidden="true"
                        />
                        <span
                            aria-current="page"
                            class="font-medium text-foreground"
                        >
                            {tag}
                        </span>
                    </li>
                </ol>
            </nav>

            <header class="mb-10">
                <h1 class="wrap-break-words text-3xl font-bold tracking-tight sm:text-4xl">
                    <span class="text-accent">#</span>
                    {tag}
                </h1>
                <p class="mt-3 text-base text-muted-foreground">
                    {posts.length}{" "}
                    {posts.length === 1
                        ? "artículo etiquetado"
                        : "artículos etiquetados"}{" "}
                    con “{tag}”.
                </p>
            </header>

            <div class="mt-8 space-y-10 sm:space-y-12">
                {posts.map((post) => (
                    <PostItem post={post} />
                ))}
            </div>
        </div>
    </section>
</Base>
