---
import Base from "../../layouts/Base.astro";
import ArchiveList from "../../components/archives/ArchiveList";
import { getArchivePosts } from "../../lib/archive_data";

const clientPosts = await getArchivePosts();
---

<Base
    title="Blog"
    description="Un espacio para compartir mis logros, las cosas que voy aprendiendo y las novedades de mi camino como desarrollador."
>
    <section class="page-container">
        <div class="max-w-3xl mx-auto mb-8">
            <h1 class="text-4xl font-bold tracking-tight text-foreground">
                Blog
            </h1>
            <p class="mt-2 text-base text-muted-foreground leading-relaxed">
                Un espacio para compartir mis logros, las cosas
                que voy aprendiendo y las novedades de mi camino como
                desarrollador.
            </p>
        </div>
        <ArchiveList posts={clientPosts} client:load />
    </section>
</Base>
